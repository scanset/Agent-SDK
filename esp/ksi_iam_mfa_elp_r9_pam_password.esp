# KSI-IAM-MFA / KSI-IAM-ELP: Rocky 9 PAM and Password Policy
# STIG: SV-258091 pwquality retry=3, SV-258095/096 pam_faillock
#       SV-258099/100 sha512 rounds, SV-258102 lcredit=-1
#       SV-258103 dcredit=-1, SV-258107 minlen=15
#       SV-258109 ocredit=-1, SV-258110 dictcheck=1
#       SV-258111 ucredit=-1, SV-258112 difok=8
#       SV-258113 maxclassrepeat=4, SV-258114 maxrepeat=3
#       SV-258115 minclass=4, SV-258233 pam_unix sha512
#       SV-258041 PASS_MAX_DAYS 60, SV-258104 PASS_MIN_DAYS 1
#       SV-258116 ENCRYPT_METHOD SHA512

META
    esp_id `ksi-iam-mfa-iam-elp-r9-pam-password-001`
    version `1.0.0`
    dsl_schema_version `1.0.0`
    platform `rocky9`
    criticality `high`

    title `KSI-IAM-MFA / KSI-IAM-ELP: Rocky 9 PAM and Password Policy`
    description `Validates password complexity, hashing algorithm, account lockout via pam_faillock, and login.defs lifecycle settings`
    author `scanset-security`
    tags `rocky9,stig,pam,password,pwquality,fedramp,KSI-IAM-MFA,KSI-IAM-ELP`

    control_mapping `KSI:KSI-IAM-MFA,KSI:KSI-IAM-ELP`
    control_objective `KSI-IAM-MFA,KSI-IAM-ELP`

    assessment_method `TEST`
    implementation_status `implemented`
    responsible_role `system-admin`

    control_origination `sp-system`
    inherited_from `Rocky9:localhost:pam-hardening`
    customer_responsibility `configuration`

    remediation_days `7`
    recommendation `Configure /etc/security/pwquality.conf for complexity requirements. Configure pam_faillock in system-auth and password-auth. Set PASS_MAX_DAYS and PASS_MIN_DAYS in /etc/login.defs. Set ENCRYPT_METHOD SHA512 in /etc/login.defs.`

    component_id `comp-r9-pam`

    impl_KSI_IAM_MFA `Password-based authentication strength is validated by confirming complexity requirements are enforced via pwquality: minimum 15 characters (minlen=15), at least one uppercase (ucredit=-1), lowercase (lcredit=-1), numeric (dcredit=-1), and special character (ocredit=-1), minimum 4 character classes changed (minclass=4), minimum 8 characters different from previous password (difok=8), maximum 3 repeating characters (maxrepeat=3), maximum 4 repeating characters of same class (maxclassrepeat=4), and dictionary word prevention (dictcheck=1). Account lockout is validated via pam_faillock configured in both system-auth and password-auth. Password hashing is validated to use SHA512 with sufficient rounds.`

    impl_KSI_IAM_ELP `Password lifecycle least privilege is validated by confirming maximum password age is 60 days (PASS_MAX_DAYS=60) and minimum password age is 1 day (PASS_MIN_DAYS=1) in /etc/login.defs, preventing both stale credentials and rapid password cycling to defeat history requirements. The encryption method is validated as SHA512 confirming passwords are stored using an approved one-way hash.`

META_END

DEF
    OBJECT pwquality_conf
        path `/etc/security/pwquality.conf`
    OBJECT_END

    OBJECT system_auth
        path `/etc/pam.d/system-auth`
    OBJECT_END

    OBJECT password_auth
        path `/etc/pam.d/password-auth`
    OBJECT_END

    OBJECT login_defs
        path `/etc/login.defs`
    OBJECT_END

    STATE pwquality_compliant
        content string contains `minlen = 15`
        content string contains `ucredit = -1`
        content string contains `lcredit = -1`
        content string contains `dcredit = -1`
        content string contains `ocredit = -1`
        content string contains `minclass = 4`
        content string contains `difok = 8`
        content string contains `maxrepeat = 3`
        content string contains `maxclassrepeat = 4`
        content string contains `dictcheck = 1`
        content string contains `retry = 3`
    STATE_END

    STATE system_auth_faillock
        content string contains `pam_faillock.so`
        content string contains `pam_pwquality.so`
        content string contains `sha512`
    STATE_END

    STATE password_auth_faillock
        content string contains `pam_faillock.so`
        content string contains `pam_pwquality.so`
        content string contains `sha512`
    STATE_END

    STATE login_defs_compliant
        content string contains `PASS_MAX_DAYS`
        content string contains `PASS_MIN_DAYS`
        content string contains `ENCRYPT_METHOD SHA512`
    STATE_END

    CRI AND
        CTN file_content
            TEST all all AND
            STATE_REF pwquality_compliant
            OBJECT_REF pwquality_conf
        CTN_END

        CTN file_content
            TEST all all AND
            STATE_REF system_auth_faillock
            OBJECT_REF system_auth
        CTN_END

        CTN file_content
            TEST all all AND
            STATE_REF password_auth_faillock
            OBJECT_REF password_auth
        CTN_END

        CTN file_content
            TEST all all AND
            STATE_REF login_defs_compliant
            OBJECT_REF login_defs
        CTN_END
    CRI_END
DEF_END
